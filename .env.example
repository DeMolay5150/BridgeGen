# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys.
# Leave empty to run BridgeGen as the in-memory public demo (no accounts, nothing saved).

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Older name also accepted: NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Never prefix with NEXT_PUBLIC_ and never commit the real value.
# Older name also accepted: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: where /pricing "Talk to us" / "Book a partnership call" buttons go (mailto: or booking link).
# Defaults to the sign-in page until set.
# NEXT_PUBLIC_SALES_CONTACT_URL=mailto:sales@your-domain.com

# Optional: public site URL used to build Decision Room invite links (defaults to the request origin).
# NEXT_PUBLIC_SITE_URL=https://bridgegen.example.com

# Optional: Upstash Redis for rate limiting the stakeholder answer endpoint (/api/respond).
# Unset = no rate limit (fine for local dev). Upstash Console → Redis → REST API.
# UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
